    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst message = item.message;\nconst callbackQuery = item.callback_query;\n\nlet action = 'unknown';\nlet chatId = '';\nlet text = '';\nlet firstName = '';\n\nif (message) {\n  chatId = String(message.chat.id);\n  text = message.text || '';\n  firstName = message.from?.first_name || 'Guest';\n\n  if (message.voice) {\n    action = 'voice_booking';\n  } else if (text.toLowerCase().includes('cancel')) {\n    action = 'cancel';\n  } else if (text.startsWith('/')) {\n    action = 'command';\n  } else if (text.toLowerCase().includes('briefing')) {\n    action = 'owner_message';\n  } else {\n    action = 'feedback_text';\n  }\n} else if (callbackQuery) {\n  chatId = String(callbackQuery.message.chat.id);\n  firstName = callbackQuery.from?.first_name || 'Guest';\n  action = callbackQuery.data;\n}\n\nreturn [{\n  json: {\n    action,\n    chatId,\n    text,\n    firstName\n  }\n}];"
      },
